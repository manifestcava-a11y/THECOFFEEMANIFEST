# Ensure consistent line endings
* text=auto

# Explicitly set line endings for specific file types
*.json text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md text eol=lf

# Package files
package.json text eol=lf
package-lock.json text eol=lf


